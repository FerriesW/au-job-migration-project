# ============================================================
# AU Migration & Jobs Radar — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in actual values.
# `.env` is gitignored — never commit real secrets.
#
# Only the GCP and Adzuna sections are required. Without the AWS block the
# S3 mirror reports itself disabled and the GCP path runs unchanged; without
# the Snowflake block the `dev_sf` dbt target simply cannot connect.
# ============================================================

# --- Adzuna API (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=au

# --- Google Cloud Platform ---
# Path to service account JSON key (absolute or relative to project root)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=au-jobs-radar
# Melbourne. The bucket and all three datasets must share this region —
# BigQuery load jobs from GCS require them to be co-located.
GCP_LOCATION=australia-southeast2
GCS_BUCKET_RAW=au-jobs-radar-raw

# BigQuery datasets
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_MARTS=marts

# --- Alibaba DashScope (Qwen) ---
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-turbo
JUDGE_MODEL=qwen-plus
# Endpoint override. Mainland China default is used when unset:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# International (Singapore) tenants with free-tier credits should use:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# --- Snowflake (multi-cloud track — dbt dev_sf target) ---
# Account: <organization>-<account> taken from the Snowsight hostname.
#   https://app.snowflake.com/abcdefg/hi12345/  =>  ABCDEFG-HI12345
# Must be an AWS-hosted account in ap-southeast-2, matching S3_BUCKET_RAW:
# cloud and region are fixed at signup and a cross-region external stage
# would incur egress on every read. Verify with `select current_region()`.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# DBT_ROLE does not exist until snowflake/01_account_objects.sql has run;
# use ACCOUNTADMIN for that first bootstrap, then switch back.
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AU_JOBS_RADAR

# --- Amazon Web Services (S3 landing zone + Athena over Glue) ---
# AwsSettings reads only AWS_REGION, S3_BUCKET_RAW, ATHENA_OUTPUT_S3 and
# ATHENA_WORKGROUP. The key pair is consumed by boto3's own credential chain,
# so moving to SSO or to a keyless OIDC role in CI needs no code change —
# just drop these two lines.
# Use an IAM user scoped to these buckets. Never the root account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_RAW=au-jobs-radar-raw

# Athena writes query results here; keep it out of the landing-zone bucket so
# that stays pure data. A 7-day expiry lifecycle rule keeps it from growing.
ATHENA_OUTPUT_S3=s3://au-jobs-radar-athena-results/
# Optional; defaults to `primary`.
# ATHENA_WORKGROUP=primary

# --- Pipeline runtime ---
LOG_LEVEL=INFO
SAMPLE_LIMIT=0  # 0 = no limit; set to e.g. 100 for dry runs
