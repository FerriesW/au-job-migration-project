service-account*.json
gcp-credentials*.json
# Local dbt profile only (holds real creds). The committed CI/CD profile at
# .github/dbt-ci/profiles.yml is credential-free and must stay tracked.
dbt/profiles.yml

# Personal working documents — kept local, not published. Listed by name
# rather than as docs/*.md, so that a new public document placed under docs/
# shows up in `git status` instead of being silently ignored. ADRs
# (docs/adr/) are tracked as architecture records.
docs/cicd-setup-guide.md
docs/gcp-setup-guide.md
docs/snowflake-setup-guide.md
docs/powerbi-setup-guide.md
docs/powerbi-dashboard-guide.md
docs/powerbi-polish-guide.md
docs/linkedin-article-draft.md
migration-job-dashboard-plan.md
HANDOFF.md

# Scratch text files, including the prepared commit messages under
# commit-msgs/. dev_log.txt is the project changelog and stays tracked, so it
# is exempted explicitly — a bare `*.txt` would not untrack it (gitignore only
# affects untracked files) but the exemption states the intent.
*.txt
!dev_log.txt

# dbt
target/
dbt_packages/
logs/
.user.yml

# Data
data/raw/
data/processed/
data/samples/
*.csv
*.jsonl
*.parquet
!data/samples/README.md
!dbt/seeds/*.csv
# Query results exported from a console as evidence. Tracked deliberately:
# these are records of what a warehouse reported on a date, not pipeline data,
# and some describe accounts that will not exist later.
!debug/evidence-*/*.csv
!dbt/seeds/README.md

